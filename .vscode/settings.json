{
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit"
	},
	"editor.tabSize": 2,
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true
	},
	"prettier.requireConfig": true,
	"eslint.enable": false
}
