{
	"name": "@sardine/colour",
	"version": "5.0.0",
	"description": "It does things to colours",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/index.min.js",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "npx vite build",
		"test": "npx vitest run --coverage",
		"bench": "npx vitest bench --run",
		"types:check": "npx tsc --noEmit",
		"lint": "npx biome check",
		"size": "size-limit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sardinedev/colour.git"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"color",
		"colour"
	],
	"author": "Hugo Nogueira",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sardinedev/colour/issues"
	},
	"homepage": "https://github.com/sardinedev/colour#readme",
	"engines": {
		"node": ">= 20"
	},
	"size-limit": [
		{
			"name": "ESM build",
			"path": "dist/index.mjs",
			"brotli": false
		}
	],
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@changesets/cli": "3.0.3",
		"@codspeed/vitest-plugin": "6.1.1",
		"@microsoft/api-extractor": "7.60.1",
		"@size-limit/preset-small-lib": "14.3.0",
		"@tsconfig/node26": "26.0.2",
		"@tsconfig/strictest": "2.0.9",
		"@types/node": "26.6.6",
		"@typescript/typescript6": "6.0.2",
		"@vitest/coverage-v8": "5.1.1",
		"lefthook": "2.2.2",
		"size-limit": "14.3.0",
		"typescript": "7.0.2",
		"unplugin-dts": "1.1.2",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"overrides": {
		"@volar/typescript": {
			"typescript": "$typescript"
		},
		"@volar/language-service": {
			"typescript": "$typescript"
		}
	}
}
