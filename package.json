{
	"name": "@sardine/colour",
	"version": "4.0.0",
	"description": "It does things to colours",
	"type": "module",
	"module": "./dist/index.mjs",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/index.min.js",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "npx vite build",
		"test": "npx vitest run --coverage",
		"types:emit": "npx tsc -p tsconfig.emit.json",
		"types:check": "npx tsc --noEmit",
		"lint": "npx biome ci src",
		"size": "size-limit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sardinedev/colour.git"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"color",
		"colour"
	],
	"author": "Hugo Nogueira",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sardinedev/colour/issues"
	},
	"homepage": "https://github.com/sardinedev/colour#readme",
	"engines": {
		"node": ">= 20"
	},
	"size-limit": [
		{
			"name": "ESM build",
			"path": "dist/index.mjs",
			"brotli": false
		},
		{
			"name": "CJS build",
			"path": "dist/index.cjs",
			"brotli": false
		}
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@changesets/cli": "2.31.1",
		"@size-limit/preset-small-lib": "13.0.3",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.11",
		"lefthook": "2.1.10",
		"size-limit": "13.0.3",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.11"
	}
}
